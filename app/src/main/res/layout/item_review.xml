<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtReviewUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="User Name"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReviewRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFF9C4"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="★ 5"
            android:textColor="#FBC02D"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtReviewDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Oct 20, 2023"
        android:textColor="#999999"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtReviewComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="The room was amazing and the service was top notch!"
        android:textColor="#333333"
        android:textSize="14sp" />

</LinearLayout>